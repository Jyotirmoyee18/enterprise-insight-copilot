# Model tiering — set whichever you have. If none are set, agents fall back
# to deterministic template-based logic so the whole pipeline still runs.
CHEAP_MODEL_PROVIDER=none        # openai | anthropic | none
CHEAP_MODEL_NAME=gpt-4o-mini
LARGE_MODEL_PROVIDER=none        # openai | anthropic | none
LARGE_MODEL_NAME=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Azure AI Services (Document Intelligence, Speech/TTS) — used by document_agent
# and content_agent when real credentials are present; otherwise stubbed.
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# GCP Document AI / Vertex Vision — used by vision_agent when present; otherwise stubbed.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
GCP_DOCUMENT_AI_PROCESSOR_ID=

DATABASE_URL=sqlite+aiosqlite:///./data/warehouse.db
